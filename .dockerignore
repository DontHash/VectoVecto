# Never ship data, weights, artifacts or research material in the image.
.git
.github
.gitignore
.pytest_cache
.venv
venv

# Training data / model weights / outputs
data
weights
artifacts
out
web_outputs
graphify-out
kaggle_*
verify_clone
upscayl-repo
testIMg
testImg

# Web app build state (the frontend is built inside the image)
webapp/frontend/node_modules
webapp/frontend/dist
webapp/runs
webapp/shots

# Research, evaluation and tooling (not needed at runtime)
legacy
evals
scripts
tests
deva_crnn
packaging
gcp

# Docs and media (README is copied only if needed; app does not read docs)
docs
*.md
!README.md
*.mp4
*.jpg
*.svg
*.png
*.ipynb
# ...but the studio's public assets are needed to build the frontend
!webapp/frontend/public
!webapp/frontend/public/**

# Python noise
__pycache__
*.py[cod]
*.egg-info
.mypy_cache
