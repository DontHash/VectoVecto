# Copy to .env and fill in:
#
#   SITE_ADDRESS — the public hostname (its DNS A/AAAA record must point at
#                  this server first; Caddy gets a Let's Encrypt certificate
#                  for it automatically)
#   ACME_EMAIL   — optional, for certificate expiry notices
#
SITE_ADDRESS=ocr.example.com
ACME_EMAIL=
