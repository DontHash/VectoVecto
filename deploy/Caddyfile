# Caddy edge: automatic TLS, request-body cap, generous-but-bounded timeouts.
# Values come from deploy/.env (SITE_ADDRESS, ACME_EMAIL).

{
	email {$ACME_EMAIL:}
	servers {
		# Behind Cloudflare? Uncomment and paste the current ranges from
		# https://www.cloudflare.com/ips/ — otherwise every visitor shares the
		# CF edge IP for rate limiting.
		# trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		# client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS:localhost} {
	# 13 MB > the app's 12 MB file cap, leaving room for multipart overhead.
	request_body {
		max_size 13MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:8000 {
		transport http {
			dial_timeout 10s
			# > app queue wait (25 s) + per-page timeout (180 s)
			read_timeout 240s
			write_timeout 30s
		}
	}
}
