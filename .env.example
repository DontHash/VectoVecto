# DataForSEO API credentials - Basic auth.
# Copy to .env (or edit .env directly), fill in, and never commit it.
# The API login is the value shown under "API login" on the API Access page
# (usually your account e-mail). The password is the API password - use
# "Reset password" there to rotate it.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# IndexNow key for Bing/Copilot URL submission (public by design; served at
# https://veriscript.live/<key>.txt). Generate in Bing Webmaster Tools or as
# any UUID. scripts/indexnow_ping.py uses it.
INDEXNOW_KEY=
